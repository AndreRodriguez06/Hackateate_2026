# ZeroMerma AI — variables de entorno
# 1. Copia este archivo como .env  (cp .env.example .env)
# 2. Cambia tu_api_key_aqui por tu llave de Google AI Studio (https://aistudio.google.com/apikey)
# .env NO se sube a git. Sin llave, la aplicación funciona en modo respaldo y lo indica en pantalla.

GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
